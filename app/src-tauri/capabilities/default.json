{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open and save the files the user picks; show the report; open the Help menu's pages; install signed updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-appcache-write-recursive",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPCACHE/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/ElikplimSunu/threatsketch/blob/main/docs/coming-from-tmt.md"
        },
        {
          "url": "https://github.com/ElikplimSunu/threatsketch/issues"
        },
        {
          "url": "https://learn.microsoft.com/en-us/azure/security/develop/threat-modeling-tool"
        },
        {
          "url": "https://www.microsoft.com/en-us/securityengineering/sdl"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
