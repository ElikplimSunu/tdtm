{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open and save the files the user picks; write the threat report to the app cache and open it.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-appcache-write-recursive",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPCACHE/**" }] }
  ]
}
