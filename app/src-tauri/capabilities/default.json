{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open and save the files the user picks; show the report; install signed updates.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-appcache-write-recursive",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPCACHE/**"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
