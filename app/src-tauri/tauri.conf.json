{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ThreatSketch",
  "version": "../package.json",
  "identifier": "io.github.elikplimsunu.threatsketch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThreatSketch",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "TMT-style threat modelling",
    "longDescription": "Draw a data-flow diagram and get Microsoft TMT's STRIDE threats as you draw.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tm7"
        ],
        "name": "Microsoft TMT model",
        "role": "Editor",
        "mimeType": "application/xml"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2QjI2RjgxMzEzM0IyQzgKUldUSXNqTXhnVyt5VnByOElJVE9VdVZMSW5QMzAvWlNWbjIxc0JTem5oU0h6VG4ycjlWcW1lMDMK",
      "endpoints": [
        "https://github.com/ElikplimSunu/tdtm/releases/latest/download/latest.json"
      ]
    }
  }
}
