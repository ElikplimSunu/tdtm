{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ThreatSketch",
  "version": "0.1.0",
  "identifier": "io.github.elikplimsunu.threatsketch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThreatSketch",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "TMT-style threat modelling",
    "longDescription": "Draw a data-flow diagram and get Microsoft TMT's STRIDE threats as you draw.",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["tm7"], "name": "Microsoft TMT model", "role": "Editor", "mimeType": "application/xml" }
    ],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
